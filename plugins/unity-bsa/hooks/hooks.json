{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit|mcp__.*__(dispatch|executeMetadataAction|create|update|delete).*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/unity-metadata-builder/scripts/guard.py\" pre",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill|mcp__.*__(soqlQuery|dispatch).*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/unity-metadata-builder/scripts/guard.py\" post",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
